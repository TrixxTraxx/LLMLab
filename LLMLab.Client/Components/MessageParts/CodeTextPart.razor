@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inherits MessagePartComponent
@using LLMLab.Client.Caches
@using LLMLab.Client.Services

<div class="code-block-container" id="@ContainerId">
    <pre class="code-block" id="@ElementId">
        <code>@((MarkupString)HighlightedContent)@(TokenParsing)@(TokenGenerating)</code>
    </pre>
    <button class="copy-code-button" @onclick="CopyCode" title="Copy code">
        <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"/>
        </svg>
    </button>
</div>

@code {
    public Guid ElementId { get; set; } = Guid.NewGuid();
    public Guid ContainerId { get; set; } = Guid.NewGuid();
    [Parameter] public MessageCache Message { get; set; } = new();
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public string? Language { get; set; }

    public string HighlightedContent = "";
    
    // The Tokens currently being parsed by syntax highlighter
    public string TokenParsing = "";
    public string LastContentBeforeParsing = "";
    // The Tokens generated since the last parsing
    public string TokenGenerating = "";
    
    public Task? HighlightContentTask;
    public Action? NextHighlightContentTask;

    protected override void OnInitialized()
    {
        InitializeHighlightedContent();
    }

    private void InitializeHighlightedContent()
    {
        if(HighlightContentTask != null && !HighlightContentTask.IsCompleted)
        {
            NextHighlightContentTask = () =>
            {
                HighlightContentTask = InitializeHighlightedContentTask();
            };
            return;
        }
        HighlightContentTask = InitializeHighlightedContentTask();
    }

    private async Task InitializeHighlightedContentTask()
    {
        try
        {
            TokenParsing = Content.Substring(LastContentBeforeParsing.Length);
            LastContentBeforeParsing = Content;
            TokenGenerating = "";
            
            if (!string.IsNullOrEmpty(Content))
            {
                var highlightedHtml = await JSRuntime.InvokeAsync<string>("getHighlightedHtml", Content);
                
                if (!string.IsNullOrEmpty(highlightedHtml))
                {
                    HighlightedContent = SanitationHelper.SanitizeHtml(highlightedHtml);
                    TokenParsing = ""; 
                }
                else
                {
                    // Fallback to plain sanitized content if highlighting fails
                }
                StateHasChanged();
                await Task.Yield();
            }
            
            if(NextHighlightContentTask != null)
            {
                var nextTask = NextHighlightContentTask;
                NextHighlightContentTask = null;
                nextTask.Invoke();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing code highlighting: {ex.Message}");
            // Fallback: render without syntax highlighting
            HighlightedContent = "";
            TokenParsing = Content;
            TokenGenerating = "";
        }
    }

    public override async Task OnTokenReceived(string fullContent)
    {
        Content = fullContent;
        TokenGenerating = fullContent.Substring(LastContentBeforeParsing.Length);
        InitializeHighlightedContent();
        // Only re-render this component when regular tokens are received
        StateHasChanged();
    }

    private async Task CopyCode()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", Content);
            Snackbar.Add("Code copied to clipboard", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy code: {ex.Message}");
            Snackbar.Add("Failed to copy code", Severity.Error);
        }
    }
} 