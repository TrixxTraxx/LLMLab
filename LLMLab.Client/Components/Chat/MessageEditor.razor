@using LLMLab.Client.Caches
@using LLMLab.Client.Models
@using LLMLab.Client.Services
@inject IJSRuntime JSRuntime
@inject AiModelService AiModelService
@inject AttachmentService AttachmentService
@inject SettingsService SettingsService
@inject ISnackbar Snackbar

<div class="message-editor-wrapper">
    <div class="message-editor-container">
        @if (editedAttachments.Any())
        {
            <div class="editor-attachments-section">
                <div class="uploaded-attachments">
                    @foreach (var attachment in editedAttachments)
                    {
                        <div class="uploaded-attachment" key="@attachment.Id">
                            <div class="attachment-info">
                                <div class="attachment-icon">
                                    @if (IsImageAttachment(attachment.ContentType))
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 19 20.1 19 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M16.5 6V17.5C16.5 19.71 14.71 21.5 12.5 21.5S8.5 19.71 8.5 17.5V5C8.5 3.62 9.62 2.5 11 2.5S13.5 3.62 13.5 5V15.5C13.5 16.05 13.05 16.5 12.5 16.5S11.5 16.05 11.5 15.5V6H10V15.5C10 16.88 11.12 18 12.5 18S15 16.88 15 15.5V5C15 2.79 13.21 1 11 1S7 2.79 7 5V17.5C7 20.54 9.46 23 12.5 23S18 20.54 18 17.5V6H16.5Z"/>
                                        </svg>
                                    }
                                </div>
                                <div class="attachment-details">
                                    <span class="attachment-name">@attachment.FileName</span>
                                    <span class="attachment-meta">@attachment.ContentType</span>
                                </div>
                            </div>
                            <button class="remove-attachment" @onclick="() => RemoveAttachment(attachment)" type="button">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"/>
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        
        @if (isUploading && pendingUploads > 0)
        {
            <div class="upload-progress">
                <div class="upload-info">
                    <svg class="upload-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                    </svg>
                    <span>Uploading @pendingUploads file(s)...</span>
                </div>
                <div class="upload-spinner">
                    <div class="spinner"></div>
                </div>
            </div>
        }
        
        <div class="editor-input-field-wrapper">
            <div class="textarea-wrapper">
                <textarea
                    value="@editedText"
                    @oninput="OnInput"
                    @onkeydown="HandleKeyDown"
                    placeholder="Edit your message..."
                    disabled="@IsSaving"
                    class="message-editor-textarea"
                    rows="3"
                    @ref="TextareaRef">
                </textarea> 
            </div>
        </div>

        <!-- Control Row -->
        <div class="editor-control-row">
            <!-- Action Buttons -->
            <div class="editor-actions">
                <button class="editor-action-btn cancel-btn"
                        @onclick="CancelEdit"
                        disabled="@IsSaving"
                        type="button">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"/>
                    </svg>
                    <span>Cancel</span>
                </button>
                
                @if (SelectedModelSupportsFiles())
                {
                    <button class="editor-action-btn attachment-btn @(editedAttachments.Any() ? "active" : "")"
                            @onclick="SelectAttachments"
                            disabled="@IsSaving"
                            type="button">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.5 6V17.5C16.5 19.71 14.71 21.5 12.5 21.5S8.5 19.71 8.5 17.5V5C8.5 3.62 9.62 2.5 11 2.5S13.5 3.62 13.5 5V15.5C13.5 16.05 13.05 16.5 12.5 16.5S11.5 16.05 11.5 15.5V6H10V15.5C10 16.88 11.12 18 12.5 18S15 16.88 15 15.5V5C15 2.79 13.21 1 11 1S7 2.79 7 5V17.5C7 20.54 9.46 23 12.5 23S18 20.54 18 17.5V6H16.5Z" fill="currentColor"/>
                        </svg>
                        <span>Attachments</span>
                    </button>
                }
                
                <button class="editor-action-btn save-btn @(CanSave ? "enabled" : "disabled")"
                        @onclick="SaveEdit"
                        disabled="@(!CanSave)"
                        type="button">
                    @if (IsSaving)
                    {
                        <div class="loading-spinner"></div>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C13.66,12 15,13.34 15,15C15,16.66 13.66,18 12,18C10.34,18 9,16.66 9,15C9,13.34 10.34,12 12,12M6,6H15V10H6V6Z"/>
                        </svg>
                    }
                    <span>Send</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden file input -->
<div class="hiddenFileInput">
    <InputFile id="hiddenFileInputEditor" OnChange="HandleFileSelected" multiple disabled="@IsSaving" class="hidden-file-input" accept="*/*" />
</div>

@code {
    [Parameter] public MessageCache Message { get; set; } = new();
    [Parameter] public EventCallback<MessageCache> OnSaveEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public int CurrentModelId { get; set; } = 1;
    [Parameter] public ReasoningEffortLevel CurrentReasoningLevel { get; set; } = ReasoningEffortLevel.None;
    
    private List<AiModelDto> aiModels = new List<AiModelDto>();
    private List<AttachmentDto> editedAttachments = new List<AttachmentDto>();
    private bool isUploading = false;
    private int pendingUploads = 0;
    private string editedText = "";
    
    public ElementReference TextareaRef;
    
    private bool CanSave => !IsSaving && !string.IsNullOrWhiteSpace(editedText) && !isUploading;

    protected override async Task OnInitializedAsync()
    {
        aiModels = await AiModelService.GetAiModels();
        
        // Initialize with current message data
        editedText = Message.Message.Text;
        
        // Load existing attachments
        if (Message.Message.AttachmentIds.Any())
        {
            foreach (var attachmentId in Message.Message.AttachmentIds)
            {
                var attachment = await AttachmentService.GetAttachment(attachmentId);
                if (attachment != null)
                {
                    editedAttachments.Add(attachment);
                }
            }
        }
        
        StateHasChanged();
        
        // Focus and auto-resize the textarea
        await Task.Delay(100); // Small delay to ensure DOM is ready
        await JSRuntime.InvokeVoidAsync("focusElement", TextareaRef);
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
            await CancelEdit();
        }
        else if (e.Key == "Enter" && e.CtrlKey)
        {
            await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
            await SaveEdit();
        }
        
        // Handle auto-resize on input
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }
    
    private async Task OnInput(ChangeEventArgs e)
    {
        editedText = e.Value?.ToString() ?? string.Empty;
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }

    private async Task SelectAttachments()
    {
        // Trigger the hidden file input
        await JSRuntime.InvokeVoidAsync("triggerFileInput", "hiddenFileInputEditor");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(10); // Limit to 10 files
        
        if (!files.Any()) return;
        
        isUploading = true;
        pendingUploads = files.Count();
        StateHasChanged();
        
        foreach (var file in files)
        {
            try
            {
                // Check file size (1MB limit)
                if (file.Size > 1024 * 1024)
                {
                    Snackbar.Add($"File {file.Name} is too large. Maximum size is 1MB.", Severity.Error);
                    pendingUploads--;
                    continue;
                }
                
                // Check if file already exists
                if (editedAttachments.Any(a => a.FileName == file.Name))
                {
                    Snackbar.Add($"File {file.Name} is already uploaded.", Severity.Warning);
                    pendingUploads--;
                    continue;
                }

                // Check if current model supports the file type for images
                if (IsImageAttachment(file.ContentType) && !SelectedModelSupportsImages())
                {
                    Snackbar.Add($"The selected model does not support image files. Please select a different model or remove the image.", Severity.Error);
                    pendingUploads--;
                    continue;
                }

                // Additional validation: Check if file type is in supported content types
                if (!IsFileTypeSupported(file.ContentType))
                {
                    Snackbar.Add($"File type '{file.ContentType}' is not supported by the selected model", Severity.Error);
                    pendingUploads--;
                    continue;
                }
                
                // Upload immediately
                var attachment = await AttachmentService.UploadAttachment(file);
                if (attachment != null)
                {
                    editedAttachments.Add(attachment);
                }
                
                pendingUploads--;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading file {file.Name}: {ex.Message}");
                Snackbar.Add($"Error uploading file {file.Name}: {ex.Message}", Severity.Error);
                pendingUploads--;
            }
        }
        
        isUploading = false;
        StateHasChanged();
    }

    private void RemoveAttachment(AttachmentDto attachment)
    {
        editedAttachments.Remove(attachment);
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (!CanSave) return;
        
        // Create new message with edited data and current model/reasoning settings
        var editedMessage = new MessageCache
        {
            Message = new MessageDto
            {
                Text = editedText,
                AttachmentIds = editedAttachments.Select(a => a.Id).ToList(),
                PreviousMessageId = Message.Message.PreviousMessageId,
                ModelId = CurrentModelId,
                ReasoningEffortLevel = CurrentReasoningLevel,
                ThreadId = Message.Message.ThreadId
            }
        };
        
        await OnSaveEdit.InvokeAsync(editedMessage);
    }

    private async Task CancelEdit()
    {
        await OnCancelEdit.InvokeAsync();
    }

    private bool SelectedModelSupportsImages()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == CurrentModelId);
        return model?.HasImageSupport == true;
    }

    private bool SelectedModelSupportsFiles()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == CurrentModelId);
        return model?.HasImageSupport == true;
    }

    private bool IsImageAttachment(string contentType)
    {
        return contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsFileTypeSupported(string contentType)
    {
        var model = aiModels.FirstOrDefault(m => m.Id == CurrentModelId);
        if (model?.SupportedContentTypes?.Any() == true)
        {
            return model.SupportedContentTypes.Any(supportedType => 
                contentType.StartsWith(supportedType));
        }
        return true; // If no supported types specified, allow all
    }
} 