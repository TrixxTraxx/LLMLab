@using LLMLab.Client.Models
@using LLMLab.Client.Services
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject AiModelService AiModelService
@inject AttachmentService AttachmentService
@inject SettingsService SettingsService
@inject ISnackbar Snackbar
@inject GenerationService GenerationService
@inject FileUtilityService FileUtility

<div class="hypermodern-chat-input-wrapper">
    <div class="hypermodern-input-container">
        @if (uploadedAttachments.Any())
        {
            <div class="attachments-section">
                <div class="uploaded-attachments">
                    @foreach (var attachment in uploadedAttachments)
                    {
                        <div class="attachment-chip" key="@attachment.Id">
                            <div class="attachment-icon">
                                @if (FileUtility.IsImageFile(attachment.ContentType))
                                {
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 19 20.1 19 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M16.5 6V17.5C16.5 19.71 14.71 21.5 12.5 21.5S8.5 19.71 8.5 17.5V5C8.5 3.62 9.62 2.5 11 2.5S13.5 3.62 13.5 5V15.5C13.5 16.05 13.05 16.5 12.5 16.5S11.5 16.05 11.5 15.5V6H10V15.5C10 16.88 11.12 18 12.5 18S15 16.88 15 15.5V5C15 2.79 13.21 1 11 1S7 2.79 7 5V17.5C7 20.54 9.46 23 12.5 23S18 20.54 18 17.5V6H16.5Z"/>
                                    </svg>
                                }
                            </div>
                            <span class="attachment-name">@attachment.FileName</span>
                            <button class="remove-attachment-btn" @onclick="() => RemoveAttachment(attachment)" type="button">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"/>
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        
        @if (isUploading && pendingUploads > 0)
        {
            <div class="upload-progress">
                <div class="upload-info">
                    <svg class="upload-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                    </svg>
                    <span>Uploading @pendingUploads file(s)...</span>
                </div>
                <div class="upload-spinner">
                    <div class="spinner"></div>
                </div>
            </div>
        }
        
        <div class="input-field-wrapper">
            <div class="textarea-wrapper">
                <textarea
                    value="@message.Text"
                    @oninput="OnInput"
                    @onkeydown="HandleKeyDown"
                    placeholder="Type your message, paste files, or drag and drop files to upload..."
                    disabled="@IsLoading"
                    class="hypermodern-textarea"
                    rows="1"
                    @ref="TextareaRef">
                </textarea> 
            </div>
            
            <div class="send-button-wrapper">
                @if (!IsLastMessageComplete)
                {
                    <!-- Stop Button when generating -->
                    <button class="hypermodern-send-btn stop-btn @(GenerationService.HasActiveGeneration() ? "enabled" : "disabled")"
                            @onclick="StopGeneration"
                            disabled="@(isStoppingGeneration || !GenerationService.HasActiveGeneration())"
                            title="@(GenerationService.HasActiveGeneration() ? "Stop generation" : "No active generation")"
                            type="button">
                        <div class="btn-content">
                            @if (isStoppingGeneration)
                            {
                                <div class="loading-spinner"></div>
                            }
                            else
                            {
                                <svg class="stop-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 6h12v12H6z"/>
                                </svg>
                            }
                        </div>
                    </button>
                }
                else
                {
                    <!-- Send Button when not generating -->
                    <button class="hypermodern-send-btn @(CanSend ? "enabled" : "disabled")"
                            @onclick="SendMessage"
                            disabled="@(!CanSend)"
                            type="button">
                        <div class="btn-content">
                            @if (IsLoading)
                            {
                                <div class="loading-spinner"></div>
                            }
                            else
                            {
                                <svg class="send-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2 21L23 12L2 3V10L17 12L2 14V21Z" fill="currentColor"/>
                                </svg>
                            }
                        </div>
                    </button>
                }
            </div>
        </div>

        <!-- Control Row -->
        <div class="control-row">
            <!-- Toggle Buttons and Model Selector -->
            <div class="control-group">
                <div class="toggle-buttons">
                    <!-- AI Model Selector Button -->
                    <div class="model-selector-wrapper">
                        <button class="hypermodern-model-btn @(showModelModal ? "active" : "")"
                                @onclick="OpenModelModal"
                                disabled="@IsLoading"
                                type="button">
                            <div class="model-btn-content">
                                <span class="model-name">@GetSelectedModelName()</span>
                                <svg class="dropdown-icon" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M7 10L12 15L17 10H7Z"/>
                                </svg>
                            </div>
                        </button>
                    </div>
                    
                    @if (SelectedModelSupportsThinking())
                    {
                        <!-- Reasoning Effort Level Selector Button -->
                        <div id="reasoning-selector-wrapper" class="reasoning-selector-wrapper">
                            <button class="hypermodern-reasoning-btn @(showReasoningModal ? "active" : "")"
                                    @onclick="ToggleReasoningModal"
                                    disabled="@IsLoading"
                                    type="button">
                                <div class="reasoning-btn-content">
                                    <svg class="reasoning-icon" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M9 21C9 21.5 9.4 22 10 22H14C14.6 22 15 21.5 15 21V20H9V21ZM12 2C8.1 2 5 5.1 5 9C5 11.4 6.2 13.5 8 14.7V17C8 17.5 8.4 18 9 18H15C15.6 18 16 17.5 16 17V14.7C17.8 13.5 19 11.4 19 9C19 5.1 15.9 2 12 2Z"/>
                                    </svg>
                                    <span class="reasoning-name">@GetSelectedReasoningLevelName()</span>
                                    <svg class="dropdown-icon" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M7 10L12 15L17 10H7Z"/>
                                    </svg>
                                </div>
                            </button>
                            
                            @if (showReasoningModal)
                            {
                                <div class="reasoning-dropdown" @onclick:stopPropagation>
                                    <div class="reasoning-options">
                                        @foreach (var level in Enum.GetValues<ReasoningEffortLevel>())
                                        {
                                            if(SelectedModelRequiresThinking() && level == ReasoningEffortLevel.None)
                                            {
                                                continue; // Skip "None" if model requires thinking
                                            }
                                            <button class="reasoning-option @(SelectedReasoningLevel == level ? "selected" : "")"
                                                    @onclick="() => OnReasoningLevelSelected(level)"
                                                    type="button">
                                                <div class="reasoning-option-content">
                                                    <div class="reasoning-option-info">
                                                        <span class="reasoning-option-name">@GetReasoningLevelDisplayName(level)</span>
                                                        <span class="reasoning-option-description">@GetReasoningLevelDescription(level)</span>
                                                    </div>
                                                    @if (SelectedReasoningLevel == level)
                                                    {
                                                        <svg class="selected-icon" viewBox="0 0 24 24" fill="currentColor">
                                                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                                        </svg>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (SelectedModelSupportsFiles())
                    {
                        <button class="hypermodern-toggle-btn @(uploadedAttachments.Any() ? "active" : "")"
                                @onclick="SelectAttachments"
                                disabled="@IsLoading"
                                type="button">
                            <svg class="toggle-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16.5 6V17.5C16.5 19.71 14.71 21.5 12.5 21.5S8.5 19.71 8.5 17.5V5C8.5 3.62 9.62 2.5 11 2.5S13.5 3.62 13.5 5V15.5C13.5 16.05 13.05 16.5 12.5 16.5S11.5 16.05 11.5 15.5V6H10V15.5C10 16.88 11.12 18 12.5 18S15 16.88 15 15.5V5C15 2.79 13.21 1 11 1S7 2.79 7 5V17.5C7 20.54 9.46 23 12.5 23S18 20.54 18 17.5V6H16.5Z" fill="currentColor"/>
                            </svg>
                            <span>Attachments</span>
                        </button>
                    }
                </div>
            </div>
        </div>
        
        @if (IsLoading)
        {
            <!--<div class="loading-indicator">
                <div class="loading-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="loading-text">Sending message...</span>
            </div> -->
        }
    </div>

    @if (ShowScrollToBottomButton)
    {
        <button class="scroll-to-bottom-btn-in-input" title="Scroll to bottom" @onclick="() => OnScrollToBottom.InvokeAsync()">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <circle cx="14" cy="14" r="13" fill="rgba(32,32,32,0.75)" />
                <path d="M9 13l5 5 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M14 7v11" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    }
</div>

<!-- Hidden file input -->
<div class="hiddenFileInput">
    <InputFile id="hiddenFileInput" OnChange="HandleFileSelected" multiple disabled="@IsLoading" class="hidden-file-input" accept="*/*" />
</div>

<!-- Model Selection Modal -->
<ModelSelectionModal 
    IsVisible="showModelModal"
    Models="aiModels"
    SelectedModelId="SelectedModelId"
    OnModelSelected="OnModelSelected"
    OnClose="CloseModelModal" />

@code {
    [Parameter] public EventCallback<MessageDto> OnSendMessage { get; set; }
    [Parameter] public EventCallback<ChatAttachment> OnAttachmentAdded { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsLastMessageComplete { get; set; }
    [Parameter] public bool ShowScrollToBottomButton { get; set; } = false;
    [Parameter] public EventCallback OnScrollToBottom { get; set; }
    
    private List<AiModelDto> aiModels = new List<AiModelDto>();
    private List<AttachmentDto> uploadedAttachments = new List<AttachmentDto>();
    private bool isUploading = false;
    private int pendingUploads = 0;
    private bool showModelModal = false;
    private bool showReasoningModal = false;
    private bool isStoppingGeneration = false;

    private MessageDto message = new MessageDto();
    public ElementReference TextareaRef;
    private int selectedModelId = 1;
    public ReasoningEffortLevel SelectedReasoningLevel = ReasoningEffortLevel.None;
    
    public int SelectedModelId
    {
        get => selectedModelId;
        set
        {
            if (selectedModelId != value)
            {
                selectedModelId = value;
                // Reset reasoning level if new model doesn't support thinking
                if (!SelectedModelSupportsThinking())
                {
                    SelectedReasoningLevel = ReasoningEffortLevel.None;
                }
            }
        }
    }
    
    private bool CanSend => !IsLoading && !string.IsNullOrWhiteSpace(message.Text) && !isUploading && IsLastMessageComplete;

    public async Task SetText(string text)
    {
        message.Text = text;
        StateHasChanged();
        
        // Focus and auto-resize the textarea
        await JSRuntime.InvokeVoidAsync("focusElement", TextareaRef);
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }

    protected override async Task OnInitializedAsync()
    {
        aiModels = await AiModelService.GetAiModels();
        
        // Try to load cached model selection first
        var cachedModelId = await SettingsService.GetSettingAsync("selectedModelId", 0);
        
        // Check if cached model exists and is available
        var cachedModel = cachedModelId > 0 ? aiModels.FirstOrDefault(m => m.Id == cachedModelId) : null;
        
        if (cachedModel != null)
        {
            // Use cached model
            selectedModelId = cachedModel.Id;
        }
        else
        {
            // Fall back to default model or first available
            var defaultModel = aiModels.FirstOrDefault(m => m.IsDefault) ?? aiModels.FirstOrDefault();
            if (defaultModel != null)
            {
                selectedModelId = defaultModel.Id;
                // Save the initial selection to cache
                await SettingsService.SetSettingAsync("selectedModelId", selectedModelId);
            }
        }
        
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("addDocumentClickHandler");
            await JSRuntime.InvokeVoidAsync("registerBlazorComponent", "reasoningMenu", DotNetObjectReference.Create(this));
            
            // Set up paste file upload functionality
            await JSRuntime.InvokeVoidAsync("setupPasteFileUpload", TextareaRef, DotNetObjectReference.Create(this));
            
            // Set up drag and drop functionality for the entire input container
            var inputContainer = await JSRuntime.InvokeAsync<IJSObjectReference>("eval", "document.querySelector('.hypermodern-input-container')");
            if (inputContainer != null)
            {
                await JSRuntime.InvokeVoidAsync("setupDragAndDrop", inputContainer, DotNetObjectReference.Create(this));
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey)
        {
            await JSRuntime.InvokeVoidAsync("eval", "event.preventDefault()");
            await SendMessage();
        }
        
        // Handle auto-resize on input
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }
    
    private async Task OnInput(ChangeEventArgs e)
    {
        message.Text = e.Value?.ToString() ?? string.Empty;
        if (showReasoningModal)
        {
            showReasoningModal = false;
        }
        await JSRuntime.InvokeVoidAsync("autoResizeTextarea", TextareaRef);
    }

    private async Task SelectAttachments()
    {
        // Trigger the hidden file input
        var currentModel = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        await JSRuntime.InvokeVoidAsync("triggerFileInput", currentModel!.SupportedContentTypes);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(10); // Limit to 10 files
        
        if (!files.Any()) return;
        
        isUploading = true;
        pendingUploads = files.Count();
        StateHasChanged();
        
        foreach (var file in files)
        {
            try
            {
                // Check file size (1MB limit)
                if (!FileUtility.IsFileSizeValid(file.Size, 1024 * 1024))
                {
                    Snackbar.Add($"File {file.Name} is too large. Maximum size is 1MB.", Severity.Error);
                    pendingUploads--;
                    continue;
                }
                
                // Generate unique filename if duplicate exists
                var existingFileNames = uploadedAttachments.Select(a => a.FileName);
                var uniqueFileName = FileUtility.GenerateUniqueFileName(file.Name, existingFileNames);

                // Check if current model supports the file type for images
                if (FileUtility.IsImageFile(file.ContentType) && !SelectedModelSupportsImages())
                {
                    Snackbar.Add($"The selected model '{GetSelectedModelName()}' does not support image files. Please select a different model or remove the image.", Severity.Error);
                    pendingUploads--;
                    continue;
                }

                // Additional validation: Check if file type is in supported content types
                var currentModel = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
                if (!FileUtility.IsFileTypeSupported(file.ContentType, currentModel?.SupportedContentTypes))
                {
                    Snackbar.Add($"File type '{file.ContentType}' is not supported by the selected model '{GetSelectedModelName()}'", Severity.Error);
                    pendingUploads--;
                    continue;
                }
                
                // Create a wrapper with unique filename if needed
                var fileToUpload = uniqueFileName != file.Name ? FileUtility.CreateRenamedFile(file, uniqueFileName) : file;
                
                // Upload immediately
                var attachment = await AttachmentService.UploadAttachment(fileToUpload);
                if (attachment != null)
                {
                    uploadedAttachments.Add(attachment);
                }
                
                pendingUploads--;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading file {file.Name}: {ex.Message}");
                Snackbar.Add($"Error uploading file {file.Name}: {ex.Message}", Severity.Error);
                pendingUploads--;
            }
        }
        
        isUploading = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandlePastedFiles(PastedFileData[] fileDataArray)
    {
        try
        {
            if (fileDataArray == null || fileDataArray.Length == 0)
            {
                return;
            }

            // Check if model supports file uploads
            if (!SelectedModelSupportsFiles())
            {
                Snackbar.Add($"The selected model '{GetSelectedModelName()}' does not support file attachments.", Severity.Error);
                return;
            }

            isUploading = true;
            pendingUploads = fileDataArray.Length;
            StateHasChanged();

            foreach (var fileData in fileDataArray)
            {
                try
                {
                    // Check file size (1MB limit)
                    if (!FileUtility.IsFileSizeValid(fileData.Size, 1024 * 1024))
                    {
                        Snackbar.Add($"Pasted file is too large. Maximum size is 1MB.", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Generate unique filename if duplicate exists
                    var existingFileNames = uploadedAttachments.Select(a => a.FileName);
                    var uniqueFileName = FileUtility.GenerateUniqueFileName(fileData.Name, existingFileNames);
                    
                    // Update the file data with unique filename
                    if (uniqueFileName != fileData.Name)
                    {
                        fileData.Name = uniqueFileName;
                    }

                    // Check if current model supports the file type for images
                    if (FileUtility.IsImageFile(fileData.Type) && !SelectedModelSupportsImages())
                    {
                        Snackbar.Add($"The selected model '{GetSelectedModelName()}' does not support image files.", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Check if file type is supported
                    var currentModel = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
                    if (!FileUtility.IsFileTypeSupported(fileData.Type, currentModel?.SupportedContentTypes))
                    {
                        Snackbar.Add($"File type '{fileData.Type}' is not supported by the selected model '{GetSelectedModelName()}'", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Create a wrapper around the file data
                    var browserFile = new JSBrowserFile(fileData);
                    
                    // Upload the file
                    var attachment = await AttachmentService.UploadAttachment(browserFile);
                    if (attachment != null)
                    {
                        uploadedAttachments.Add(attachment);
                        Snackbar.Add($"Pasted file uploaded successfully", Severity.Success);
                    }

                    pendingUploads--;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error uploading pasted file: {ex.Message}");
                    Snackbar.Add($"Error uploading pasted file: {ex.Message}", Severity.Error);
                    pendingUploads--;
                }
            }

            isUploading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling pasted files: {ex.Message}");
            Snackbar.Add($"Error handling pasted files: {ex.Message}", Severity.Error);
            isUploading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task HandleDroppedFiles(PastedFileData[] fileDataArray)
    {
        try
        {
            if (fileDataArray == null || fileDataArray.Length == 0)
            {
                return;
            }

            // Check if model supports file uploads
            if (!SelectedModelSupportsFiles())
            {
                Snackbar.Add($"The selected model '{GetSelectedModelName()}' does not support file attachments.", Severity.Error);
                return;
            }

            isUploading = true;
            pendingUploads = fileDataArray.Length;
            StateHasChanged();

            foreach (var fileData in fileDataArray)
            {
                try
                {
                    // Check file size (1MB limit)
                    if (!FileUtility.IsFileSizeValid(fileData.Size, 1024 * 1024))
                    {
                        Snackbar.Add($"Dropped file '{fileData.Name}' is too large. Maximum size is 1MB.", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Generate unique filename if duplicate exists
                    var existingFileNames = uploadedAttachments.Select(a => a.FileName);
                    var uniqueFileName = FileUtility.GenerateUniqueFileName(fileData.Name, existingFileNames);
                    
                    // Update the file data with unique filename
                    if (uniqueFileName != fileData.Name)
                    {
                        fileData.Name = uniqueFileName;
                    }

                    // Check if current model supports the file type for images
                    if (FileUtility.IsImageFile(fileData.Type) && !SelectedModelSupportsImages())
                    {
                        Snackbar.Add($"The selected model '{GetSelectedModelName()}' does not support image files. Please select a different model or remove the image.", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Check if file type is supported
                    var currentModel = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
                    if (!FileUtility.IsFileTypeSupported(fileData.Type, currentModel?.SupportedContentTypes))
                    {
                        Snackbar.Add($"File type '{fileData.Type}' is not supported by the selected model '{GetSelectedModelName()}'", Severity.Error);
                        pendingUploads--;
                        continue;
                    }

                    // Create a wrapper around the file data
                    var browserFile = new JSBrowserFile(fileData);
                    
                    // Upload the file
                    var attachment = await AttachmentService.UploadAttachment(browserFile);
                    if (attachment != null)
                    {
                        uploadedAttachments.Add(attachment);
                        Snackbar.Add($"File '{attachment.FileName}' uploaded successfully", Severity.Success);
                    }

                    pendingUploads--;
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error uploading dropped file '{fileData.Name}': {ex.Message}");
                    Snackbar.Add($"Error uploading dropped file '{fileData.Name}': {ex.Message}", Severity.Error);
                    pendingUploads--;
                }
            }

            isUploading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling dropped files: {ex.Message}");
            Snackbar.Add($"Error handling dropped files: {ex.Message}", Severity.Error);
            isUploading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void AddSnackbarMessage(string message, string severity = "Warning")
    {
        try
        {
            Console.WriteLine($"AddSnackbarMessage called with message: '{message}', severity: '{severity}'");
            
            var snackbarSeverity = severity.ToLower() switch
            {
                "error" => Severity.Error,
                "success" => Severity.Success,
                "info" => Severity.Info,
                _ => Severity.Warning
            };
            
            Console.WriteLine($"Converted severity to: {snackbarSeverity}");
            
            Snackbar.Add(message, snackbarSeverity);
            
            Console.WriteLine($"Successfully added snackbar message: '{message}'");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding snackbar message: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private void RemoveAttachment(AttachmentDto attachment)
    {
        uploadedAttachments.Remove(attachment);
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;
        
        // Set the selected model ID on the message
        message.ModelId = selectedModelId;
        
        // Set the reasoning effort level
        message.ReasoningEffortLevel = SelectedReasoningLevel;
        
        // Add attachment IDs to message
        message.AttachmentIds = uploadedAttachments.Select(a => a.Id).ToList();
        
        IsLoading = true;
        StateHasChanged();
        
        try
        {
            await OnSendMessage.InvokeAsync(message);
            
            // Reset form
            message = new MessageDto();
            uploadedAttachments.Clear();
            
            // Reset textarea height immediately
            await JSRuntime.InvokeVoidAsync("resetTextareaHeight", TextareaRef);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenModelModal()
    {
        showModelModal = true;
        StateHasChanged();
    }

    private void CloseModelModal()
    {
        showModelModal = false;
        StateHasChanged();
    }

    private async void OnModelSelected(int modelId)
    {
        SelectedModelId = modelId;
        // Cache the selected model
        await SettingsService.SetSettingAsync("selectedModelId", modelId);
        StateHasChanged();
    }

    private string GetSelectedModelName()
    {
        if (!aiModels.Any())
        {
            return "Loading...";
        }
        
        var model = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        return model?.Name ?? "Select Model";
    }

    private bool SelectedModelSupportsThinking()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        return model?.HasThinkingSupport == true;
    }

    private bool SelectedModelRequiresThinking()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        return model?.RequireThinking == true;
    }
    
    private bool SelectedModelSupportsImages()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        return model?.HasImageSupport == true;
    }

    private bool SelectedModelSupportsFiles()
    {
        var model = aiModels.FirstOrDefault(m => m.Id == selectedModelId);
        return model?.HasImageSupport == true;
    }

    private void ToggleReasoningModal()
    {
        showReasoningModal = !showReasoningModal; // Toggle the modal
        StateHasChanged();
    }

    private void CloseReasoningModal()
    {
        showReasoningModal = false;
        StateHasChanged();
    }

    private void OnReasoningLevelSelected(ReasoningEffortLevel level)
    {
        SelectedReasoningLevel = level;
        message.ReasoningEffortLevel = level;
        showReasoningModal = false;
        StateHasChanged();
    }

    private string GetSelectedReasoningLevelName()
    {
        if(SelectedReasoningLevel == ReasoningEffortLevel.None && SelectedModelRequiresThinking())
        {
            // If model requires thinking, default to Low
            SelectedReasoningLevel = ReasoningEffortLevel.Low;
        }
        return GetReasoningLevelDisplayName(SelectedReasoningLevel);
    }

    private string GetReasoningLevelDisplayName(ReasoningEffortLevel level)
    {
        return level switch
        {
            ReasoningEffortLevel.None => "None",
            ReasoningEffortLevel.Low => "Low",
            ReasoningEffortLevel.Medium => "Medium", 
            ReasoningEffortLevel.High => "High",
            _ => "None"
        };
    }

    private string GetReasoningLevelDescription(ReasoningEffortLevel level)
    {
        return level switch
        {
            ReasoningEffortLevel.None => "No thinking",
            ReasoningEffortLevel.Low => "Basic reasoning",
            ReasoningEffortLevel.Medium => "Enhanced reasoning",
            ReasoningEffortLevel.High => "Maximum reasoning",
            _ => "No thinking"
        };
    }

    [JSInvokable]
    public void HandleDocumentClick()
    {
        if (showReasoningModal)
        {
            CloseReasoningModal();
        }
    }

    private async Task StopGeneration()
    {
        if (isStoppingGeneration) return;
        
        isStoppingGeneration = true;
        StateHasChanged();
        
        try
        {
            // Use static method to access the actual connected GenerationService instance
            bool success = await GenerationService.StopActiveGeneration();
            
            if (success)
            {
                Snackbar.Add("Generation stopped", Severity.Info);
            }
            else
            {
                Snackbar.Add("No active generation to stop", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to stop generation: {ex.Message}");
            Snackbar.Add("Failed to stop generation", Severity.Error);
        }
        finally
        {
            isStoppingGeneration = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        // Clean up paste event handler
        JSRuntime.InvokeVoidAsync("removePasteFileUpload", TextareaRef);
        
        // Clean up drag and drop functionality
        JSRuntime.InvokeVoidAsync("eval", @"
            const inputContainer = document.querySelector('.hypermodern-input-container');
            if (inputContainer && window.removeDragAndDrop) {
                window.removeDragAndDrop(inputContainer);
            }
        ");
        
        JSRuntime.InvokeVoidAsync("removeDocumentClickHandler");
        JSRuntime.InvokeVoidAsync("unregisterBlazorComponent", "reasoningMenu");
    }
} 