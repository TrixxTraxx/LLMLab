@inject IJSRuntime JSRuntime
@implements IDisposable

<button class="hypermodern-new-chat-btn" @onclick="OnClick">
    <div class="btn-content">
        <div class="btn-left">
            <span class="btn-text">NEW CHAT</span>
        </div>
        <div class="btn-shortcut">
            <span class="kbd" @ref="shortcutRef">@(IsMac ? "⌘" : "Ctrl+")B</span>
        </div>
    </div>
</button>

@code {
    [Parameter] public EventCallback OnClick { get; set; }
    
    private ElementReference shortcutRef;
    private Action? cleanupShortcut;
    private bool IsMac;

    protected override async Task OnInitializedAsync()
    {
        // Detect platform for shortcut display using safe function
        IsMac = await JSRuntime.InvokeAsync<bool>("isMacPlatform");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register visual feedback for Ctrl/Cmd+B shortcut
            cleanupShortcut = await JSRuntime.InvokeAsync<Action>("registerShortcutVisual", "ctrl+b", shortcutRef);
        }
    }

    public void Dispose()
    {
        cleanupShortcut?.Invoke();
    }
} 