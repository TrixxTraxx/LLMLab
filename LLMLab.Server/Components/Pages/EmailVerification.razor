@page "/emailVerification"
@layout EmailVerificationLayout
@using LLMLab.Server.Data
@using LLMLab.Server.Components.Layout
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject IdentityRedirectManager RedirectManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Email Verification - LLM Lab</PageTitle>

<div class="email-verification-page">
    @if (isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">Checking verification status...</MudText>
        </div>
    }
    else if (showVerificationForm)
    {
        <div class="verification-container">
            <div class="verification-card">
                <div class="verification-header">
                    <div class="verification-icon-container">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" Size="Size.Large" Class="verification-icon" />
                        <div class="icon-glow"></div>
                    </div>
                    <MudText Typo="Typo.h4" Class="verification-title">Email Verification Required</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="verification-subtitle">
                        Please verify your email address to continue using LLMLab.
                    </MudText>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <MudAlert Severity="@messageSeverity" Class="verification-alert">
                        @message
                    </MudAlert>
                }

                <div class="verification-content">
                    <div class="verification-actions">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   FullWidth="true"
                                   OnClick="ResendVerificationEmail"
                                   Disabled="isResending || resendCooldown > 0"
                                   Class="verification-btn primary-btn">
                            @if (isResending)
                            {
                                <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Size="Size.Small" Class="mr-2" />
                            }
                            @(isResending ? "Sending..." : (resendCooldown > 0 ? $"Resend in {resendCooldown}s" : "Resend Verification Email"))
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Secondary" 
                                   FullWidth="true"
                                   Class="verification-btn secondary-btn"
                                   OnClick="CheckVerificationStatus">
                            I've Verified My Email
                        </MudButton>

                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Primary" 
                                   FullWidth="true"
                                   Class="verification-btn text-btn"
                                   OnClick="@(() => NavigationManager.NavigateTo("/LogoutRemote", true))">
                            Sign Out
                        </MudButton>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-container">
            <div class="error-card">
                <MudAlert Severity="Severity.Error" Class="error-alert">
                    @errorMessage
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RedirectToDefault" Class="error-btn">
                    Go to Home
                </MudButton>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool showVerificationForm = false;
    private bool isResending = false;
    private string? message;
    private string? errorMessage;
    private Severity messageSeverity = Severity.Info;
    private ApplicationUser? currentUser;
    private int resendCooldown = 0;
    private System.Timers.Timer? cooldownTimer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckUserStatus();
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task CheckUserStatus()
    {
        isLoading = true;
        showVerificationForm = false;
        message = null;
        errorMessage = null;

        // Get authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Check if user is signed in
        if (!user.Identity?.IsAuthenticated == true)
        {
            // Not signed in, redirect to default page
            RedirectToDefault();
            return;
        }

        // Get current user
        var userId = UserManager.GetUserId(user);
        if (string.IsNullOrEmpty(userId))
        {
            RedirectToDefault();
            return;
        }

        currentUser = await UserManager.FindByIdAsync(userId);
        if (currentUser == null)
        {
            RedirectToDefault();
            return;
        }

        // Check if email is already verified
        if (currentUser.EmailConfirmed)
        {
            RedirectToDefault();
            return;
        }

        // Check if user has external logins
        var externalLogins = await UserManager.GetLoginsAsync(currentUser);
        if (externalLogins.Any())
        {
            // User has external authentication, redirect to default page
            RedirectToDefault();
            return;
        }

        // User needs email verification and has no external auth
        showVerificationForm = true;
        isLoading = false;
        await ResendVerificationEmail();
    }

    private void RedirectToDefault()
    {
        var clientUrl = Configuration["AppSettings:ClientUrl"] + Configuration["AppSettings:ClientAfterLoginPath"];
        if (!string.IsNullOrEmpty(clientUrl))
        {
            NavigationManager.NavigateTo(clientUrl, forceLoad: true);
        }
        else
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task ResendVerificationEmail()
    {
        if (currentUser == null || resendCooldown > 0) return;

        isResending = true;
        message = null;
        StateHasChanged();

        try
        {
            var userId = await UserManager.GetUserIdAsync(currentUser);
            var code = await UserManager.GenerateEmailConfirmationTokenAsync(currentUser);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

            await EmailSender.SendConfirmationLinkAsync(currentUser, currentUser.Email!, HtmlEncoder.Default.Encode(callbackUrl));

            message = $"Verification email sent to {currentUser.Email}. Please check your inbox.";
            messageSeverity = Severity.Success;
            StartResendCooldown();
        }
        catch (Exception ex)
        {
            message = $"Error sending verification email: {ex.Message}";
            messageSeverity = Severity.Error;
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }

    private void StartResendCooldown()
    {
        resendCooldown = 30;
        cooldownTimer?.Dispose();
        cooldownTimer = new System.Timers.Timer(1000);
        cooldownTimer.Elapsed += (s, e) =>
        {
            if (resendCooldown > 0)
            {
                resendCooldown--;
                InvokeAsync(StateHasChanged);
            }
            if (resendCooldown == 0)
            {
                cooldownTimer?.Dispose();
            }
        };
        cooldownTimer.Start();
    }

    private async Task CheckVerificationStatus()
    {
        if (currentUser == null) return;

        // Refresh user data from database
        currentUser = await UserManager.FindByIdAsync(currentUser.Id);
        if (currentUser?.EmailConfirmed == true)
        {
            message = "Email verified successfully! Redirecting...";
            messageSeverity = Severity.Success;
            await Task.Delay(2000);
            await CheckUserStatus(); // Re-check status and redirect if verified
        }
        else
        {
            message = "Email not yet verified. Please check your inbox and click the verification link.";
            messageSeverity = Severity.Warning;
        }
    }
} 